# Generate a unique key locally:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
NCS_SECRET_KEY=

# Used only when creating the initial administrator on an empty database.
NCS_DEFAULT_ADMIN_USER=operator
NCS_DEFAULT_ADMIN_PASS=

# SQLite is the implemented database backend.
SQLITE_FILENAME=hospital_monitor.db

# Keep the web UI on this machine by default.
SERVER_HOST=127.0.0.1
SERVER_PORT=9000

# UDP device listener; expose only on the trusted device network.
UDP_IP=0.0.0.0
UDP_PORT=6345
