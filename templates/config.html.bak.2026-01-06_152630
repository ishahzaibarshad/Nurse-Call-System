<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>System Configuration - Hospital Monitoring</title>
  <link href="/static/css/output.css" rel="stylesheet">
</head>

<body class="bg-slate-50 text-slate-900">
  <div class="min-h-screen flex">
    <aside id="sidebar" class="hidden md:block w-64 bg-slate-900 text-white"></aside>

    <main class="flex-1 p-4 md:p-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h1 class="text-2xl font-semibold">System Configuration</h1>
          <p class="text-sm text-slate-600">Floors • Wards • Rooms • Beds • Colors</p>
        </div>
        <div class="flex gap-2">
          <button id="refreshBtn" class="px-3 py-2 rounded-lg bg-slate-900 text-white hover:bg-slate-800">
            Refresh
          </button>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap gap-2" id="tabs">
        <button class="tabBtn px-3 py-2 rounded-lg bg-white border" data-tab="floors">Floors</button>
        <button class="tabBtn px-3 py-2 rounded-lg bg-white border" data-tab="wards">Wards</button>
        <button class="tabBtn px-3 py-2 rounded-lg bg-white border" data-tab="rooms">Rooms</button>
        <button class="tabBtn px-3 py-2 rounded-lg bg-white border" data-tab="beds">Beds</button>
        <button class="tabBtn px-3 py-2 rounded-lg bg-white border" data-tab="colors">Colors</button>
      </div>

      <!-- Toast -->
      <div id="toast" class="fixed bottom-4 right-4 hidden max-w-md bg-slate-900 text-white px-4 py-3 rounded-xl shadow-lg"></div>

      <!-- Sections -->
      <section id="sec-floors" class="mt-5"></section>
      <section id="sec-wards" class="mt-5 hidden"></section>
      <section id="sec-rooms" class="mt-5 hidden"></section>
      <section id="sec-beds" class="mt-5 hidden"></section>
      <section id="sec-colors" class="mt-5 hidden"></section>
    </main>
  </div>

  <!-- Modal -->
  <div id="modalWrap" class="fixed inset-0 hidden items-center justify-center bg-black/40 p-4">
    <div class="w-full max-w-2xl rounded-2xl bg-white shadow-xl border">
      <div class="flex items-center justify-between px-5 py-4 border-b">
        <h2 id="modalTitle" class="text-lg font-semibold">Modal</h2>
        <button id="modalClose" class="px-2 py-1 rounded-lg hover:bg-slate-100">✕</button>
      </div>
      <form id="modalForm" class="p-5 space-y-4">
        <div id="modalBody" class="space-y-4"></div>
        <div class="flex items-center justify-end gap-2 pt-2">
          <button type="button" id="modalCancel" class="px-4 py-2 rounded-lg border hover:bg-slate-50">Cancel</button>
          <button type="submit" class="px-4 py-2 rounded-lg bg-slate-900 text-white hover:bg-slate-800">Save</button>
        </div>
      </form>
    </div>
  </div>

<script>
(function () {
  const API = {
    floors: "/api/config/floors",
    wards: "/api/config/wards",
    rooms: "/api/config/rooms",
    beds: "/api/config/beds",
    colors: "/api/config/colors",
  };

  const state = { floors: [], wards: [], rooms: [], beds: [], colors: [] };

  const $ = (id) => document.getElementById(id);

  function esc(s) {
    return String(s ?? "").replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;"
    }[c]));
  }

  function toast(msg) {
    const el = $("toast");
    el.textContent = msg;
    el.classList.remove("hidden");
    clearTimeout(el._t);
    el._t = setTimeout(() => el.classList.add("hidden"), 2500);
  }

  async function apiFetch(url, opts = {}) {
    const o = Object.assign({ headers: {} }, opts);
    if (o.body && typeof o.body !== "string") {
      o.headers["Content-Type"] = "application/json";
      o.body = JSON.stringify(o.body);
    }
    const res = await fetch(url, o);
    const txt = await res.text();
    let data = null;
    try { data = txt ? JSON.parse(txt) : null; } catch { data = { raw: txt }; }
    if (!res.ok) {
      const err = (data && (data.error || data.message)) ? (data.error || data.message) : ("HTTP " + res.status);
      throw new Error(err);
    }
    return data;
  }

  function setTab(tab) {
    document.querySelectorAll(".tabBtn").forEach(b => {
      const on = b.dataset.tab === tab;
      b.classList.toggle("bg-slate-900", on);
      b.classList.toggle("text-white", on);
      b.classList.toggle("bg-white", !on);
      b.classList.toggle("text-slate-900", !on);
    });

    ["floors","wards","rooms","beds","colors"].forEach(t => {
      $("sec-" + t).classList.toggle("hidden", t !== tab);
    });
  }

  async function loadSidebar() {
    try {
      const r = await fetch("/sidebar.html");
      if (!r.ok) return;
      $("sidebar").innerHTML = await r.text();
    } catch {}
  }

  async function loadAll() {
    const [floors, wards, rooms, beds, colors] = await Promise.all([
      apiFetch(API.floors),
      apiFetch(API.wards),
      apiFetch(API.rooms),
      apiFetch(API.beds),
      apiFetch(API.colors),
    ]);
    state.floors = floors.floors || [];
    state.wards  = wards.wards || [];
    state.rooms  = rooms.rooms || [];
    state.beds   = beds.beds || [];
    state.colors = colors.colors || [];

    renderFloors();
    renderWards();
    renderRooms();
    renderBeds();
    renderColors();
  }

  function cardShell(title, addAction, tableHeadHtml, tableBodyHtml) {
    return `
      <div class="bg-white border rounded-2xl shadow-sm">
        <div class="flex items-center justify-between px-5 py-4 border-b">
          <h3 class="font-semibold">${esc(title)}</h3>
          <button class="px-3 py-2 rounded-lg bg-slate-900 text-white hover:bg-slate-800"
                  data-action="${esc(addAction)}">Add</button>
        </div>
        <div class="p-4 overflow-auto">
          <table class="min-w-full text-sm">
            <thead class="text-left text-slate-600">
              <tr>${tableHeadHtml}</tr>
            </thead>
            <tbody class="divide-y">
              ${tableBodyHtml}
            </tbody>
          </table>
        </div>
      </div>
    `;
  }

  function renderFloors() {
    const rows = state.floors.map(f => `
      <tr>
        <td class="py-2 pr-4 font-medium">${esc(f.name)}</td>
        <td class="py-2 pr-4">${esc(f.floor_number)}</td>
        <td class="py-2 pr-4">${esc(f.status)}</td>
        <td class="py-2 pr-4">${esc(f.wards ?? 0)}</td>
        <td class="py-2 whitespace-nowrap">
          <button class="px-2 py-1 rounded border hover:bg-slate-50" data-action="edit-floor" data-id="${f.id}">Edit</button>
          <button class="px-2 py-1 rounded border hover:bg-slate-50 ml-2" data-action="del-floor" data-id="${f.id}">Delete</button>
        </td>
      </tr>
    `).join("");

    $("sec-floors").innerHTML = cardShell(
      "Floors", "add-floor",
      `<th class="py-2 pr-4">Name</th><th class="py-2 pr-4">No</th><th class="py-2 pr-4">Status</th><th class="py-2 pr-4">Wards</th><th class="py-2">Actions</th>`,
      rows || `<tr><td class="py-3 text-slate-500" colspan="5">No floors yet</td></tr>`
    );
  }

  function renderWards() {
    const floorNameById = Object.fromEntries(state.floors.map(f => [f.id, f.name]));
    const rows = state.wards.map(w => `
      <tr>
        <td class="py-2 pr-4 font-medium">${esc(w.name)}</td>
        <td class="py-2 pr-4">${esc(floorNameById[w.floor_id] || w.floor_id)}</td>
        <td class="py-2 pr-4">${esc(w.ward_type || w.type || "")}</td>
        <td class="py-2 pr-4">${esc(w.status)}</td>
        <td class="py-2 pr-4">${esc(w.rooms ?? 0)}</td>
        <td class="py-2 whitespace-nowrap">
          <button class="px-2 py-1 rounded border hover:bg-slate-50" data-action="edit-ward" data-id="${w.id}">Edit</button>
          <button class="px-2 py-1 rounded border hover:bg-slate-50 ml-2" data-action="del-ward" data-id="${w.id}">Delete</button>
        </td>
      </tr>
    `).join("");

    $("sec-wards").innerHTML = cardShell(
      "Wards", "add-ward",
      `<th class="py-2 pr-4">Name</th><th class="py-2 pr-4">Floor</th><th class="py-2 pr-4">Type</th><th class="py-2 pr-4">Status</th><th class="py-2 pr-4">Rooms</th><th class="py-2">Actions</th>`,
      rows || `<tr><td class="py-3 text-slate-500" colspan="6">No wards yet</td></tr>`
    );
  }

  function renderRooms() {
    const wardNameById = Object.fromEntries(state.wards.map(w => [w.id, w.name]));
    const rows = state.rooms.map(r => `
      <tr>
        <td class="py-2 pr-4 font-medium">${esc(r.room_name || r.roomName)}</td>
        <td class="py-2 pr-4">${esc(r.room_number || r.roomNumber || "")}</td>
        <td class="py-2 pr-4">${esc(wardNameById[r.ward_id] || r.ward_id)}</td>
        <td class="py-2 pr-4">${esc(r.system_ip || r.systemIp || "")}</td>
        <td class="py-2 pr-4">${esc(r.status || "")}</td>
        <td class="py-2 whitespace-nowrap">
          <button class="px-2 py-1 rounded border hover:bg-slate-50" data-action="edit-room" data-id="${r.id}">Edit</button>
          <button class="px-2 py-1 rounded border hover:bg-slate-50 ml-2" data-action="del-room" data-id="${r.id}">Delete</button>
        </td>
      </tr>
    `).join("");

    $("sec-rooms").innerHTML = cardShell(
      "Rooms", "add-room",
      `<th class="py-2 pr-4">Room Name</th><th class="py-2 pr-4">Room No</th><th class="py-2 pr-4">Ward</th><th class="py-2 pr-4">System IP</th><th class="py-2 pr-4">Status</th><th class="py-2">Actions</th>`,
      rows || `<tr><td class="py-3 text-slate-500" colspan="6">No rooms yet</td></tr>`
    );
  }

  function renderBeds() {
    const roomNameById = Object.fromEntries(state.rooms.map(r => [r.id, (r.room_name || r.roomName)]));
    const rows = state.beds.map(b => `
      <tr>
        <td class="py-2 pr-4">${esc(roomNameById[b.room_id] || b.room_name || b.room_id)}</td>
        <td class="py-2 pr-4 font-medium">${esc(b.bed_number || b.bedNumber || b.bedNo)}</td>
        <td class="py-2 pr-4">${esc(b.bed_name || b.bedName || "")}</td>
        <td class="py-2 pr-4">${esc(b.intercom_ip || b.ipAddress || b.ip_address || "")}</td>
        <td class="py-2 pr-4">${esc(b.status || "")}</td>
        <td class="py-2 whitespace-nowrap">
          <button class="px-2 py-1 rounded border hover:bg-slate-50" data-action="edit-bed" data-id="${b.id}">Edit</button>
          <button class="px-2 py-1 rounded border hover:bg-slate-50 ml-2" data-action="del-bed" data-id="${b.id}">Delete</button>
        </td>
      </tr>
    `).join("");

    $("sec-beds").innerHTML = cardShell(
      "Beds", "add-bed",
      `<th class="py-2 pr-4">Room</th><th class="py-2 pr-4">Bed No</th><th class="py-2 pr-4">Bed Name</th><th class="py-2 pr-4">Intercom IP</th><th class="py-2 pr-4">Status</th><th class="py-2">Actions</th>`,
      rows || `<tr><td class="py-3 text-slate-500" colspan="6">No beds yet</td></tr>`
    );
  }

  function renderColors() {
    const rows = state.colors.map(c => `
      <tr>
        <td class="py-2 pr-4 font-medium">${esc(c.event_type || c.eventType)}</td>
        <td class="py-2 pr-4">${esc(c.color)}</td>
        <td class="py-2 whitespace-nowrap">
          <button class="px-2 py-1 rounded border hover:bg-slate-50" data-action="edit-color" data-id="${c.id}">Edit</button>
          <button class="px-2 py-1 rounded border hover:bg-slate-50 ml-2" data-action="del-color" data-id="${c.id}">Delete</button>
        </td>
      </tr>
    `).join("");

    $("sec-colors").innerHTML = cardShell(
      "Colors", "add-color",
      `<th class="py-2 pr-4">Event Type</th><th class="py-2 pr-4">Color</th><th class="py-2">Actions</th>`,
      rows || `<tr><td class="py-3 text-slate-500" colspan="3">No colors yet</td></tr>`
    );
  }

  // ---------- Modal ----------
  const modalWrap = $("modalWrap");
  const modalTitle = $("modalTitle");
  const modalBody = $("modalBody");
  const modalForm = $("modalForm");
  let modalCtx = { entity: null, mode: null, id: null };

  function openModal(entity, mode, item) {
    modalCtx = { entity, mode, id: item?.id ?? null };

    modalTitle.textContent = (mode === "create" ? "Add " : "Edit ") + entity.toUpperCase();

    const statusSelect = (val) => `
      <select name="status" class="w-full border rounded-lg px-3 py-2">
        <option value="active" ${val==="active"?"selected":""}>active</option>
        <option value="inactive" ${val==="inactive"?"selected":""}>inactive</option>
        <option value="available" ${val==="available"?"selected":""}>available</option>
      </select>
    `;

    if (entity === "floor") {
      modalBody.innerHTML = `
        <div>
          <label class="text-sm text-slate-600">Name</label>
          <input name="name" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.name || "")}" required>
        </div>
        <div>
          <label class="text-sm text-slate-600">Floor Number</label>
          <input name="floor_number" type="number" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.floor_number ?? "")}" required>
        </div>
        <div>
          <label class="text-sm text-slate-600">Description</label>
          <input name="description" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.description || "")}">
        </div>
        <div>
          <label class="text-sm text-slate-600">Status</label>
          ${statusSelect(item?.status || "active")}
        </div>
      `;
    }

    if (entity === "ward") {
      const floorOptions = state.floors.map(f => `<option value="${f.id}" ${(item?.floor_id===f.id)?"selected":""}>${esc(f.name)}</option>`).join("");
      modalBody.innerHTML = `
        <div>
          <label class="text-sm text-slate-600">Name</label>
          <input name="name" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.name || "")}" required>
        </div>
        <div>
          <label class="text-sm text-slate-600">Floor</label>
          <select name="floor_id" class="w-full border rounded-lg px-3 py-2" required>
            <option value="">Select</option>
            ${floorOptions}
          </select>
        </div>
        <div>
          <label class="text-sm text-slate-600">Ward Type</label>
          <input name="ward_type" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.ward_type || item?.type || "")}">
        </div>
        <div>
          <label class="text-sm text-slate-600">Description</label>
          <input name="description" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.description || "")}">
        </div>
        <div>
          <label class="text-sm text-slate-600">Status</label>
          ${statusSelect(item?.status || "active")}
        </div>
      `;
    }

    if (entity === "room") {
      const wardOptions = state.wards.map(w => `<option value="${w.id}" ${(item?.ward_id===w.id)?"selected":""}>${esc(w.name)}</option>`).join("");
      modalBody.innerHTML = `
        <div>
          <label class="text-sm text-slate-600">Ward</label>
          <select name="ward_id" class="w-full border rounded-lg px-3 py-2" required>
            <option value="">Select</option>
            ${wardOptions}
          </select>
        </div>
        <div>
          <label class="text-sm text-slate-600">Room Name</label>
          <input name="room_name" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.room_name || item?.roomName || "")}" required>
        </div>
        <div>
          <label class="text-sm text-slate-600">Room Number</label>
          <input name="room_number" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.room_number || item?.roomNumber || "")}">
        </div>
        <div>
          <label class="text-sm text-slate-600">System IP</label>
          <input name="system_ip" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.system_ip || item?.systemIp || "")}">
        </div>
        <div>
          <label class="text-sm text-slate-600">Status</label>
          ${statusSelect(item?.status || "active")}
        </div>
      `;
    }

    if (entity === "bed") {
      const roomOptions = state.rooms.map(r => `<option value="${r.id}" ${(item?.room_id===r.id)?"selected":""}>${esc(r.room_name || r.roomName)}</option>`).join("");
      modalBody.innerHTML = `
        <div>
          <label class="text-sm text-slate-600">Room</label>
          <select name="room_id" class="w-full border rounded-lg px-3 py-2" required>
            <option value="">Select</option>
            ${roomOptions}
          </select>
        </div>
        <div>
          <label class="text-sm text-slate-600">Bed Number</label>
          <input name="bed_number" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.bed_number || item?.bedNumber || item?.bedNo || "")}" required>
        </div>
        <div>
          <label class="text-sm text-slate-600">Bed Name</label>
          <input name="bed_name" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.bed_name || item?.bedName || "")}">
        </div>
        <div>
          <label class="text-sm text-slate-600">Intercom IP</label>
          <input name="intercom_ip" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.intercom_ip || item?.ipAddress || item?.ip_address || "")}">
        </div>
        <div>
          <label class="text-sm text-slate-600">Status</label>
          ${statusSelect(item?.status || "available")}
        </div>
      `;
    }

    if (entity === "color") {
      modalBody.innerHTML = `
        <div>
          <label class="text-sm text-slate-600">Event Type</label>
          <input name="event_type" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.event_type || item?.eventType || "")}" required>
        </div>
        <div>
          <label class="text-sm text-slate-600">Color</label>
          <input name="color" class="w-full border rounded-lg px-3 py-2" value="${esc(item?.color || "")}" placeholder="#ff0000" required>
        </div>
      `;
    }

    modalWrap.classList.remove("hidden");
    modalWrap.classList.add("flex");
  }

  function closeModal() {
    modalWrap.classList.add("hidden");
    modalWrap.classList.remove("flex");
    modalBody.innerHTML = "";
  }

  $("modalClose").addEventListener("click", closeModal);
  $("modalCancel").addEventListener("click", closeModal);
  modalWrap.addEventListener("click", (e) => { if (e.target === modalWrap) closeModal(); });

  // ---------- Actions (event delegation) ----------
  document.addEventListener("click", async (e) => {
    const btn = e.target.closest("[data-action]");
    if (!btn) return;
    const action = btn.dataset.action;
    const id = btn.dataset.id ? Number(btn.dataset.id) : null;

    try {
      if (action === "add-floor") return openModal("floor", "create", null);
      if (action === "add-ward")  return openModal("ward", "create", null);
      if (action === "add-room")  return openModal("room", "create", null);
      if (action === "add-bed")   return openModal("bed",  "create", null);
      if (action === "add-color") return openModal("color","create", null);

      if (action === "edit-floor") return openModal("floor", "edit", state.floors.find(x => x.id === id));
      if (action === "edit-ward")  return openModal("ward",  "edit", state.wards.find(x => x.id === id));
      if (action === "edit-room")  return openModal("room",  "edit", state.rooms.find(x => x.id === id));
      if (action === "edit-bed")   return openModal("bed",   "edit", state.beds.find(x => x.id === id));
      if (action === "edit-color") return openModal("color", "edit", state.colors.find(x => x.id === id));

      if (action === "del-floor") {
        if (!confirm("Delete floor?")) return;
        await apiFetch(`${API.floors}/${id}`, { method: "DELETE" });
        toast("Floor deleted");
        return loadAll();
      }
      if (action === "del-ward") {
        if (!confirm("Delete ward?")) return;
        await apiFetch(`${API.wards}/${id}`, { method: "DELETE" });
        toast("Ward deleted");
        return loadAll();
      }
      if (action === "del-room") {
        if (!confirm("Delete room?")) return;
        await apiFetch(`${API.rooms}/${id}`, { method: "DELETE" });
        toast("Room deleted");
        return loadAll();
      }
      if (action === "del-bed") {
        if (!confirm("Delete bed?")) return;
        await apiFetch(`${API.beds}/${id}`, { method: "DELETE" });
        toast("Bed deleted");
        return loadAll();
      }
      if (action === "del-color") {
        if (!confirm("Delete color?")) return;
        await apiFetch(`${API.colors}/${id}`, { method: "DELETE" });
        toast("Color deleted");
        return loadAll();
      }
    } catch (err) {
      toast("Error: " + (err?.message || err));
    }
  });

  modalForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(modalForm);
    const entity = modalCtx.entity;
    const mode = modalCtx.mode;
    const id = modalCtx.id;

    try {
      if (entity === "floor") {
        const body = {
          name: fd.get("name"),
          floor_number: Number(fd.get("floor_number")),
          description: fd.get("description"),
          status: fd.get("status"),
        };
        if (mode === "create") await apiFetch(API.floors, { method: "POST", body });
        else await apiFetch(`${API.floors}/${id}`, { method: "PUT", body });
      }

      if (entity === "ward") {
        const body = {
          name: fd.get("name"),
          floor_id: Number(fd.get("floor_id")),
          ward_type: fd.get("ward_type"),
          description: fd.get("description"),
          status: fd.get("status"),
        };
        if (mode === "create") await apiFetch(API.wards, { method: "POST", body });
        else await apiFetch(`${API.wards}/${id}`, { method: "PUT", body });
      }

      if (entity === "room") {
        const body = {
          ward_id: Number(fd.get("ward_id")),
          room_name: fd.get("room_name"),
          room_number: fd.get("room_number"),
          system_ip: fd.get("system_ip"),
          status: fd.get("status"),
        };
        if (mode === "create") await apiFetch(API.rooms, { method: "POST", body });
        else await apiFetch(`${API.rooms}/${id}`, { method: "PUT", body });
      }

      if (entity === "bed") {
        const body = {
          room_id: Number(fd.get("room_id")),
          bed_number: fd.get("bed_number"),
          bed_name: fd.get("bed_name"),
          intercom_ip: fd.get("intercom_ip"),
          status: fd.get("status"),
        };
        if (mode === "create") await apiFetch(API.beds, { method: "PUT", body });  // ✅ PUT create also supported
        else await apiFetch(`${API.beds}/${id}`, { method: "PUT", body });
      }

      if (entity === "color") {
        const body = { event_type: fd.get("event_type"), color: fd.get("color") };
        if (mode === "create") await apiFetch(API.colors, { method: "POST", body });
        else await apiFetch(`${API.colors}/${id}`, { method: "PUT", body });
      }

      closeModal();
      toast("Saved");
      await loadAll();

    } catch (err) {
      toast("Error: " + (err?.message || err));
    }
  });

  // Tabs
  document.querySelectorAll(".tabBtn").forEach(b => b.addEventListener("click", () => setTab(b.dataset.tab)));

  $("refreshBtn").addEventListener("click", async () => {
    try { await loadAll(); toast("Refreshed"); } catch (e) { toast("Error: " + e.message); }
  });

  // Init
  (async function init() {
    setTab("floors");
    await loadSidebar();
    await loadAll();
  })();

})();
</script>
</body>
</html>
